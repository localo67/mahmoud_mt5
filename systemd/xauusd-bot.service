[Unit]
Description=MT5 AI XAUUSD Read-Only Bot (No MT5 on Linux)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/opt/mt5-ai-bot
ExecStart=/usr/bin/env TRADING_MODE=off /opt/mt5-ai-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/mt5-ai-bot/.env

[Install]
WantedBy=multi-user.target
